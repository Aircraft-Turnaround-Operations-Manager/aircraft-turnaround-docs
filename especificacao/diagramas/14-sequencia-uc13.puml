@startuml 14-sequencia-uc13
' Diagrama de Sequência do UC13 – Corrigir horário de chegada à posição (RF-13, US013; ADR-0013).
' Imagens: python scripts/exportar_plantuml.py especificacao/diagramas/14-sequencia-uc13.puml
!include 14-sequencia-estilo.iuml

actor "Coordenador de Turnaround" as co
box "Site (computador)"
boundary "ChegadaView" as view
end box
box "Porta de entrada"
participant "PortaDeEntrada" as gw <<gateway>>
end box
box "Execução em Solo"
control "TurnaroundController" as ctl
participant "TurnaroundService" as svc <<service>>
participant "TurnaroundRepository" as rep <<repository>>
database "BancoExecucaoEmSolo" as db
participant "AvisoPublisher" as pub <<publisher>>
end box
queue "RabbitMQ" as mq
participant "Monitoramento" as mon <<serviço>>

== Passos 1 e 2: chegada registrada e histórico ==
co -> view : selecionarCorrigirHorario(turnaroundId)
activate view
view -> gw : consultarChegada(turnaroundId)
activate gw
ref over gw : B.1 – Verificar o acesso\nna porta de entrada
gw -> ctl : consultarChegada(turnaroundId, usuarioId, perfil)
activate ctl
ctl -> svc : consultarChegada(turnaroundId)
activate svc
svc -> rep : buscarChegadaComCorrecoes(turnaroundId)
activate rep
rep -> db : SELECT turnaround, marco (tipo = 'AIBT'), correcao_aibt\nWHERE turnaround_id = :turnaroundId ORDER BY corrigido_em
activate db
db --> rep : turnaround, AIBT atual e correções anteriores
deactivate db
rep --> svc : chegada
deactivate rep
svc --> ctl : chegada
deactivate svc
ctl --> gw : chegada
deactivate ctl
gw --> view : chegada
deactivate gw
view --> co : exibirCorrecao(turnaround, aibtAtual, historicoDeCorrecoes)

alt cancelar (A1)
  co -> view : cancelar()
  view --> co : fecharFormulario()\n[AIBT e histórico mantidos]
else salvar (passo 3)
  co -> view : salvarCorrecao(turnaroundId, novoAibt, motivo)
  view -> view : requisicaoId = novoUuid()
  view -> gw : corrigirChegada(turnaroundId, novoAibt, motivo, requisicaoId)
  activate gw
  ref over gw : B.1 – Verificar o acesso\nna porta de entrada\n(acesso revogado: E3)
  gw -> ctl : corrigirChegada(turnaroundId, novoAibt, motivo, requisicaoId, usuarioId, perfil)
  activate ctl
  ctl -> ctl : verificarPerfil(perfil, "Coordenador de Turnaround")
  ctl -> svc : corrigirChegada(turnaroundId, coordenadorId, novoAibt, motivo, requisicaoId)
  activate svc
  svc -> rep : buscarParaAtualizar(turnaroundId)
  activate rep
  rep -> db : SELECT turnaround, marco (tipo = 'AIBT')\nWHERE turnaround.id = :turnaroundId FOR UPDATE
  activate db
  db --> rep : estado e AIBT atual
  deactivate db
  rep -> db : SELECT correcao_aibt WHERE requisicao_id = :requisicaoId
  activate db
  db --> rep : correção já gravada com essa requisição (ou nenhuma)
  deactivate db
  rep --> svc : turnaround, correcaoExistente
  deactivate rep

  alt correcaoExistente (E4.2: resposta perdida e nova tentativa)
    svc --> ctl : correcaoExistente\n[não grava outra correção nem outro aviso]
  else sem AIBT ou turnaround.estado = "Fora de bloco" (E1)
    svc --> ctl : Recusa("sem chegada registrada ou turnaround encerrado")
  else motivo vazio ou novoAibt inválido ou futuro (E2)
    svc --> ctl : Recusa(campo, "informe o motivo e um horário válido e não futuro")
  else correção válida (passo 5)
    svc -> rep : salvarCorrecao(turnaround, valorAnterior = aibtAtual, novoAibt, motivo, coordenadorId, requisicaoId)
    activate rep
    rep -> db : transação:\nUPDATE marco SET horario = :novoAibt WHERE tipo = 'AIBT'\nINSERT INTO correcao_aibt (turnaround_id, valor_anterior, valor_novo, motivo, autor_id, corrigido_em = agora, requisicao_id)
    activate db
    opt turnaround.estado ≠ "Liberado" (passo 6)
      rep -> db : INSERT INTO aviso_saida (ChegadaCorrigida)\n[na mesma transação]
    end
    alt falha ao gravar (E4.1)
      db --> rep : ROLLBACK
      rep --> svc : FalhaAoGravar
      svc --> ctl : Falha("correção não concluída")
    else gravado
      db --> rep : COMMIT
      rep --> svc : correção gravada
      svc --> ctl : chegada (novoAibt, historicoDeCorrecoes)\n[estados do turnaround e das tarefas sem mudança]
    end
    deactivate db
    deactivate rep
  end
  deactivate svc
  ctl --> gw : resposta
  deactivate ctl
  gw --> view : resposta
  deactivate gw

  alt recusa (E1 termina; E2 volta ao passo 3; E3 termina sem alterar dados)
    view --> co : exibirRecusa(motivo, campo)
  else falha ou resposta perdida (E4)
    view --> co : exibirAviso("correção não confirmada; tente de novo")\n[a nova tentativa usa a mesma requisicaoId]
  else correção gravada (passo 7)
    view --> co : exibirChegada(novoAibt, historico com valor anterior, motivo, autor e horário da correção)
    opt turnaround.estado ≠ "Liberado" (passo 6)
      ref over pub, mq : B.2 – Publicar o aviso ChegadaCorrigida pela caixa de saída\n(E5: o aviso fica na caixa de saída para nova tentativa)
      mq ->> mon : entregar(ChegadaCorrigida)
      note over mon : o Monitoramento recalcula a\nprojeção de prontidão (UC24)
    end
  end
end
deactivate view
@enduml
