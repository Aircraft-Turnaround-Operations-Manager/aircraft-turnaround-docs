<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_turnaround" targetNamespace="https://github.com/Aircraft-Turnaround-Operations-Manager">
  <message id="Msg_voo" name="Voo previsto" />
  <message id="Msg_aibt" name="Aeronave em posição" />
  <message id="Msg_atc" name="Autorização de acionamento" />
  <message id="Msg_reg" name="Registro de andamento" />
  <signal id="Sig_risco" name="Alerta de risco ao horário" />
  <signal id="Sig_prev" name="Pedido de atualização da previsão" />
  <collaboration id="Collab">
    <participant id="P_main" name="Aircraft Turnaround Orchestration System — turnaround (TO BE)" processRef="Proc_turnaround" />
    <participant id="P_atc" name="Controle de tráfego aéreo (ATC) — fora do escopo" />
    <messageFlow id="MF_atc" sourceRef="P_atc" targetRef="IE_atc" />
  </collaboration>
  <process id="Proc_turnaround" name="Turnaround da aeronave" isExecutable="false">
    <laneSet id="LS">
      <lane id="L_coord" name="Coordenador de Turnaround">
        <flowNodeRef>S0</flowNodeRef>
        <flowNodeRef>T_abrir</flowNodeRef>
        <flowNodeRef>T_ajustar</flowNodeRef>
        <flowNodeRef>T_tratar</flowNodeRef>
        <flowNodeRef>ESP_alerta</flowNodeRef>
        <flowNodeRef>ESP_prev</flowNodeRef>
        <flowNodeRef>ESP_tobt</flowNodeRef>
      </lane>
      <lane id="L_oper" name="Operador de Solo/Rampa">
        <flowNodeRef>IE_aibt</flowNodeRef>
        <flowNodeRef>T_calcar</flowNodeRef>
        <flowNodeRef>T_portas</flowNodeRef>
        <flowNodeRef>IE_atc</flowNodeRef>
        <flowNodeRef>T_push</flowNodeRef>
        <flowNodeRef>SP_solo</flowNodeRef>
      </lane>
      <lane id="L_motor" name="Motor de Eventos">
        <flowNodeRef>T_viab</flowNodeRef>
        <flowNodeRef>G_viab</flowNodeRef>
        <flowNodeRef>T_verif</flowNodeRef>
        <flowNodeRef>G_pend</flowNodeRef>
        <flowNodeRef>T_fim</flowNodeRef>
        <flowNodeRef>E_fim</flowNodeRef>
        <flowNodeRef>ESP_mon</flowNodeRef>
      </lane>
      <lane id="L_aut" name="Autoridade de Liberação">
        <flowNodeRef>T_lib</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S0" name="Voo previsto para a posição">
      <messageEventDefinition id="ED_S0" messageRef="Msg_voo" />
    </startEvent>
    <userTask id="T_abrir" name="Abrir o turnaround: tarefas, janelas, dependências e responsáveis" />
    <serviceTask id="T_viab" name="Verificar a viabilidade (EIBT + MTTT ≤ TOBT)" />
    <exclusiveGateway id="G_viab" name="Turnaround viável?" />
    <userTask id="T_ajustar" name="Ajustar o plano ou o TOBT" />
    <intermediateCatchEvent id="IE_aibt" name="Aeronave em posição (AIBT)">
      <messageEventDefinition id="ED_IE_aibt" messageRef="Msg_aibt" />
    </intermediateCatchEvent>
    <userTask id="T_calcar" name="Posicionar ponte ou escada e registrar o início do atendimento (ACGT)" />
    <subProcess id="SP_solo" name="Executar as tarefas em solo">
      <startEvent id="S_solo" name="Atendimento iniciado" />
      <parallelGateway id="F1" name="" />
      <userTask id="T_desemb" name="Desembarcar os passageiros" />
      <intermediateThrowEvent id="ITS_desemb" name="Desembarque concluído" />
      <parallelGateway id="F2" name="" />
      <userTask id="T_limp" name="Limpar a cabine (confirmação por QR Code)" />
      <userTask id="T_cat" name="Carregar o catering" />
      <parallelGateway id="J2" name="" />
      <exclusiveGateway id="G_pax" name="Abastecimento com passageiros permitido?" />
      <intermediateCatchEvent id="ICS_fuel" name="Abastecimento concluído">
        <conditionalEventDefinition id="ED_ICS_fuel">
          <condition xsi:type="tFormalExpression">abastecimentoDoTurnaroundConcluido = true</condition>
        </conditionalEventDefinition>
      </intermediateCatchEvent>
      <exclusiveGateway id="M_pax" name="" />
      <userTask id="T_emb" name="Embarcar os passageiros (ASBT)" />
      <userTask id="T_desc" name="Descarregar bagagem e carga" />
      <userTask id="T_carr" name="Carregar bagagem e carga" />
      <exclusiveGateway id="G_fuel" name="Abastecimento com passageiros permitido?" />
      <intermediateCatchEvent id="ICS_desemb" name="Desembarque concluído">
        <conditionalEventDefinition id="ED_ICS_desemb">
          <condition xsi:type="tFormalExpression">desembarqueDoTurnaroundConcluido = true</condition>
        </conditionalEventDefinition>
      </intermediateCatchEvent>
      <exclusiveGateway id="M_fuel" name="" />
      <userTask id="T_fuel" name="Abastecer a aeronave" />
      <intermediateThrowEvent id="ITS_fuel" name="Abastecimento concluído" />
      <userTask id="T_agua" name="Atender água potável e lavatórios" />
      <userTask id="T_insp" name="Realizar a inspeção técnica de trânsito" />
      <parallelGateway id="J3" name="" />
      <userTask id="T_load" name="Emitir a loadsheet (peso e balanceamento)" />
      <parallelGateway id="J4" name="" />
      <sequenceFlow id="F_F1_T_desemb" name="" sourceRef="F1" targetRef="T_desemb" />
      <sequenceFlow id="F_F1_T_desc" name="" sourceRef="F1" targetRef="T_desc" />
      <sequenceFlow id="F_F1_G_fuel" name="" sourceRef="F1" targetRef="G_fuel" />
      <sequenceFlow id="F_F1_T_agua" name="" sourceRef="F1" targetRef="T_agua" />
      <sequenceFlow id="F_F1_T_insp" name="" sourceRef="F1" targetRef="T_insp" />
      <sequenceFlow id="F_T_desemb_ITS_desemb" name="" sourceRef="T_desemb" targetRef="ITS_desemb" />
      <sequenceFlow id="F_ITS_desemb_F2" name="" sourceRef="ITS_desemb" targetRef="F2" />
      <sequenceFlow id="F_F2_T_limp" name="" sourceRef="F2" targetRef="T_limp" />
      <sequenceFlow id="F_F2_T_cat" name="" sourceRef="F2" targetRef="T_cat" />
      <sequenceFlow id="F_T_limp_J2" name="" sourceRef="T_limp" targetRef="J2" />
      <sequenceFlow id="F_T_cat_J2" name="" sourceRef="T_cat" targetRef="J2" />
      <sequenceFlow id="F_J2_G_pax" name="" sourceRef="J2" targetRef="G_pax" />
      <sequenceFlow id="F_G_pax_M_pax" name="Sim" sourceRef="G_pax" targetRef="M_pax" />
      <sequenceFlow id="F_G_pax_ICS_fuel" name="Não" sourceRef="G_pax" targetRef="ICS_fuel" />
      <sequenceFlow id="F_ICS_fuel_M_pax" name="" sourceRef="ICS_fuel" targetRef="M_pax" />
      <sequenceFlow id="F_M_pax_T_emb" name="" sourceRef="M_pax" targetRef="T_emb" />
      <sequenceFlow id="F_T_desc_T_carr" name="" sourceRef="T_desc" targetRef="T_carr" />
      <sequenceFlow id="F_G_fuel_M_fuel" name="Sim" sourceRef="G_fuel" targetRef="M_fuel" />
      <sequenceFlow id="F_G_fuel_ICS_desemb" name="Não" sourceRef="G_fuel" targetRef="ICS_desemb" />
      <sequenceFlow id="F_ICS_desemb_M_fuel" name="" sourceRef="ICS_desemb" targetRef="M_fuel" />
      <sequenceFlow id="F_M_fuel_T_fuel" name="" sourceRef="M_fuel" targetRef="T_fuel" />
      <sequenceFlow id="F_T_fuel_ITS_fuel" name="" sourceRef="T_fuel" targetRef="ITS_fuel" />
      <sequenceFlow id="F_T_emb_J3" name="" sourceRef="T_emb" targetRef="J3" />
      <sequenceFlow id="F_T_carr_J3" name="" sourceRef="T_carr" targetRef="J3" />
      <sequenceFlow id="F_J3_T_load" name="" sourceRef="J3" targetRef="T_load" />
      <sequenceFlow id="F_T_load_J4" name="" sourceRef="T_load" targetRef="J4" />
      <sequenceFlow id="F_ITS_fuel_J4" name="" sourceRef="ITS_fuel" targetRef="J4" />
      <sequenceFlow id="F_T_agua_J4" name="" sourceRef="T_agua" targetRef="J4" />
      <sequenceFlow id="F_T_insp_J4" name="" sourceRef="T_insp" targetRef="J4" />
      <endEvent id="E_solo" name="Tarefas em solo concluídas" />
      <sequenceFlow id="F_S_solo_F1" sourceRef="S_solo" targetRef="F1" />
      <sequenceFlow id="F_J4_E_solo" sourceRef="J4" targetRef="E_solo" />
    </subProcess>
    <userTask id="T_portas" name="Fechar portas, retirar a ponte e registrar o fim do atendimento (AEGT)" />
    <serviceTask id="T_verif" name="Verificar tarefas obrigatórias e exceções abertas (Pronto para liberação)" />
    <exclusiveGateway id="G_pend" name="Há tarefa obrigatória pendente ou exceção aberta?" />
    <userTask id="T_tratar" name="Tratar a pendência ou a exceção" />
    <userTask id="T_lib" name="Confirmar a prontidão e liberar a aeronave (ARDT)" />
    <intermediateCatchEvent id="IE_atc" name="Autorização de acionamento e push-back recebida">
      <messageEventDefinition id="ED_IE_atc" messageRef="Msg_atc" />
    </intermediateCatchEvent>
    <userTask id="T_push" name="Fazer o push-back e registrar a saída da posição (AOBT)" />
    <serviceTask id="T_fim" name="Encerrar o turnaround (Fora de bloco)" />
    <endEvent id="E_fim" name="Turnaround encerrado" />
    <subProcess id="ESP_mon" name="Monitoramento a cada registro (Motor de Eventos)" triggeredByEvent="true">
      <startEvent id="S_mon" name="Registro de andamento recebido" isInterrupting="false">
        <messageEventDefinition id="ED_S_mon" messageRef="Msg_reg" />
      </startEvent>
      <serviceTask id="T_rec" name="Propagar estados e recalcular projeção, caminho crítico e aderência ao TOBT + 5 min" />
      <serviceTask id="T_painel" name="Atualizar o painel (até 5 s)" />
      <exclusiveGateway id="G_desvio" name="Há desvio?" />
      <endEvent id="E_risco" name="Alerta de risco ao horário">
        <signalEventDefinition id="ED_E_risco" signalRef="Sig_risco" />
      </endEvent>
      <endEvent id="E_prev" name="Pedido de atualização da previsão">
        <signalEventDefinition id="ED_E_prev" signalRef="Sig_prev" />
      </endEvent>
      <endEvent id="E_ok" name="Sem desvio" />
      <sequenceFlow id="F_S_mon_T_rec" name="" sourceRef="S_mon" targetRef="T_rec" />
      <sequenceFlow id="F_T_rec_T_painel" name="" sourceRef="T_rec" targetRef="T_painel" />
      <sequenceFlow id="F_T_painel_G_desvio" name="" sourceRef="T_painel" targetRef="G_desvio" />
      <sequenceFlow id="F_G_desvio_E_risco" name="Risco ao horário (T8, T11, T12)" sourceRef="G_desvio" targetRef="E_risco" />
      <sequenceFlow id="F_G_desvio_E_prev" name="Antecipação ≥ 5 min" sourceRef="G_desvio" targetRef="E_prev" />
      <sequenceFlow id="F_G_desvio_E_ok" name="Não" sourceRef="G_desvio" targetRef="E_ok" />
    </subProcess>
    <subProcess id="ESP_alerta" name="Tratamento de alerta de risco" triggeredByEvent="true">
      <startEvent id="S_al" name="Alerta de risco ao horário" isInterrupting="false">
        <signalEventDefinition id="ED_S_al" signalRef="Sig_risco" />
      </startEvent>
      <userTask id="T_al" name="Tratar o alerta: redistribuir recursos, replanejar e registrar a causa (código ANAC)" />
      <endEvent id="E_al" name="Ação registrada" />
      <sequenceFlow id="F_S_al_T_al" name="" sourceRef="S_al" targetRef="T_al" />
      <sequenceFlow id="F_T_al_E_al" name="" sourceRef="T_al" targetRef="E_al" />
    </subProcess>
    <subProcess id="ESP_prev" name="Atualização da previsão" triggeredByEvent="true">
      <startEvent id="S_pv" name="Pedido de atualização da previsão" isInterrupting="false">
        <signalEventDefinition id="ED_S_pv" signalRef="Sig_prev" />
      </startEvent>
      <userTask id="T_pv" name="Atualizar a previsão (TOBT)" />
      <endEvent id="E_pv" name="Previsão atualizada" />
      <sequenceFlow id="F_S_pv_T_pv" name="" sourceRef="S_pv" targetRef="T_pv" />
      <sequenceFlow id="F_T_pv_E_pv" name="" sourceRef="T_pv" targetRef="E_pv" />
    </subProcess>
    <subProcess id="ESP_tobt" name="Checagem em TOBT − 15 min" triggeredByEvent="true">
      <startEvent id="S_tb" name="TOBT − 15 min" isInterrupting="false">
        <timerEventDefinition id="TD_S_tb">
          <timeDate xsi:type="tFormalExpression">TOBT - 15 min</timeDate>
        </timerEventDefinition>
      </startEvent>
      <userTask id="T_tb" name="Conferir o prazo com todas as equipes e ajustar o TOBT se preciso" />
      <endEvent id="E_tb" name="Prazo conferido" />
      <sequenceFlow id="F_S_tb_T_tb" name="" sourceRef="S_tb" targetRef="T_tb" />
      <sequenceFlow id="F_T_tb_E_tb" name="" sourceRef="T_tb" targetRef="E_tb" />
    </subProcess>
    <sequenceFlow id="F_S0_T_abrir" name="" sourceRef="S0" targetRef="T_abrir" />
    <sequenceFlow id="F_T_abrir_T_viab" name="" sourceRef="T_abrir" targetRef="T_viab" />
    <sequenceFlow id="F_T_viab_G_viab" name="" sourceRef="T_viab" targetRef="G_viab" />
    <sequenceFlow id="F_G_viab_T_ajustar" name="Não" sourceRef="G_viab" targetRef="T_ajustar" />
    <sequenceFlow id="F_T_ajustar_T_viab" name="" sourceRef="T_ajustar" targetRef="T_viab" />
    <sequenceFlow id="F_G_viab_IE_aibt" name="Sim" sourceRef="G_viab" targetRef="IE_aibt" />
    <sequenceFlow id="F_IE_aibt_T_calcar" name="" sourceRef="IE_aibt" targetRef="T_calcar" />
    <sequenceFlow id="F_T_calcar_SP_solo" name="" sourceRef="T_calcar" targetRef="SP_solo" />
    <sequenceFlow id="F_SP_solo_T_portas" name="" sourceRef="SP_solo" targetRef="T_portas" />
    <sequenceFlow id="F_T_portas_T_verif" name="" sourceRef="T_portas" targetRef="T_verif" />
    <sequenceFlow id="F_T_verif_G_pend" name="" sourceRef="T_verif" targetRef="G_pend" />
    <sequenceFlow id="F_G_pend_T_tratar" name="Sim" sourceRef="G_pend" targetRef="T_tratar" />
    <sequenceFlow id="F_T_tratar_T_verif" name="" sourceRef="T_tratar" targetRef="T_verif" />
    <sequenceFlow id="F_G_pend_T_lib" name="Não" sourceRef="G_pend" targetRef="T_lib" />
    <sequenceFlow id="F_T_lib_IE_atc" name="" sourceRef="T_lib" targetRef="IE_atc" />
    <sequenceFlow id="F_IE_atc_T_push" name="" sourceRef="IE_atc" targetRef="T_push" />
    <sequenceFlow id="F_T_push_T_fim" name="" sourceRef="T_push" targetRef="T_fim" />
    <sequenceFlow id="F_T_fim_E_fim" name="" sourceRef="T_fim" targetRef="E_fim" />
  </process>
  <bpmndi:BPMNDiagram id="D_principal">
    <bpmndi:BPMNPlane id="D_principal_plano" bpmnElement="Collab">
      <bpmndi:BPMNShape id="D_principal_S0" bpmnElement="S0">
        <dc:Bounds x="197" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="165" y="202" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_abrir" bpmnElement="T_abrir">
        <dc:Bounds x="270" y="130" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_ajustar" bpmnElement="T_ajustar">
        <dc:Bounds x="575" y="130" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_viab" bpmnElement="T_viab">
        <dc:Bounds x="425" y="330" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_G_viab" bpmnElement="G_viab" isMarkerVisible="true">
        <dc:Bounds x="635" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="409" width="70" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_IE_aibt" bpmnElement="IE_aibt">
        <dc:Bounds x="752" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="566" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_calcar" bpmnElement="T_calcar">
        <dc:Bounds x="835" y="530" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_SP_solo" bpmnElement="SP_solo" isExpanded="false">
        <dc:Bounds x="1055" y="530" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_portas" bpmnElement="T_portas">
        <dc:Bounds x="1265" y="530" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_verif" bpmnElement="T_verif">
        <dc:Bounds x="1425" y="330" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_G_pend" bpmnElement="G_pend" isMarkerVisible="true">
        <dc:Bounds x="1635" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1595" y="409" width="130" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_tratar" bpmnElement="T_tratar">
        <dc:Bounds x="1575" y="130" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_lib" bpmnElement="T_lib">
        <dc:Bounds x="1695" y="710" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_IE_atc" bpmnElement="IE_atc">
        <dc:Bounds x="1962" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1935" y="500" width="90" height="58" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_push" bpmnElement="T_push">
        <dc:Bounds x="2025" y="530" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_T_fim" bpmnElement="T_fim">
        <dc:Bounds x="2195" y="330" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_E_fim" bpmnElement="E_fim">
        <dc:Bounds x="2382" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2350" y="402" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_ESP_alerta" bpmnElement="ESP_alerta" isExpanded="false">
        <dc:Bounds x="795" y="130" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_ESP_prev" bpmnElement="ESP_prev" isExpanded="false">
        <dc:Bounds x="985" y="130" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_ESP_tobt" bpmnElement="ESP_tobt" isExpanded="false">
        <dc:Bounds x="1175" y="130" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_ESP_mon" bpmnElement="ESP_mon" isExpanded="false">
        <dc:Bounds x="795" y="330" width="170" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="2390" height="760" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_L_coord" bpmnElement="L_coord" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="2360" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_L_motor" bpmnElement="L_motor" isHorizontal="true">
        <dc:Bounds x="130" y="280" width="2360" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_L_oper" bpmnElement="L_oper" isHorizontal="true">
        <dc:Bounds x="130" y="480" width="2360" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_L_aut" bpmnElement="L_aut" isHorizontal="true">
        <dc:Bounds x="130" y="680" width="2360" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_principal_P_atc" bpmnElement="P_atc" isHorizontal="true">
        <dc:Bounds x="100" y="880" width="2390" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="D_principal_F_S0_T_abrir" bpmnElement="F_S0_T_abrir">
        <di:waypoint x="233" y="180" />
        <di:waypoint x="270" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_principal_F_T_abrir_T_viab" bpmnElement="F_T_abrir_T_viab">
        <di:waypoint x="355" y="230" />
        <di:waypoint x="355" y="380" />
        <di:waypoint x="425" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_principal_F_T_viab_G_viab" bpmnElement="F_T_viab_G_viab">
        <di:waypoint x="595" y="380" />
        <di:waypoint x="635" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_principal_F_G_viab_T_ajustar" bpmnElement="F_G_viab_T_ajustar">
        <di:waypoint x="660" y="355" />
        <di:waypoint x="660" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="331" width="30" height="14" />
