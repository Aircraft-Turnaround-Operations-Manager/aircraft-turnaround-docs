<message id="Msg_voo" name="Voo previsto"/><message id="Msg_aibt" name="Aeronave em posição"/><message id="Msg_atc" name="Autorização de acionamento"/><message id="Msg_reg" name="Registro de andamento"/><signal id="Sig_desemb" name="Desembarque concluído"/><signal id="Sig_fuel" name="Abastecimento concluído"/><signal id="Sig_risco" name="Alerta de risco ao horário"/><signal id="Sig_prev" name="Pedido de atualização da previsão"/>
<collaboration id="Collab"><participant id="P_main" name="Aircraft Turnaround Orchestration System — turnaround (TO BE)" processRef="Proc_turnaround"/><participant id="P_atc" name="Controle de tráfego aéreo (ATC) — fora do escopo"/><messageFlow id="MF_atc" sourceRef="P_atc" targetRef="IE_atc"/></collaboration>
<process id="Proc_turnaround" name="Turnaround da aeronave" isExecutable="false"><laneSet id="LS"><lane id="L_coord" name="Coordenador de Turnaround"><flowNodeRef>S0</flowNodeRef><flowNodeRef>T_abrir</flowNodeRef><flowNodeRef>T_ajustar</flowNodeRef><flowNodeRef>T_tratar</flowNodeRef><flowNodeRef>ESP_alerta</flowNodeRef><flowNodeRef>ESP_prev</flowNodeRef><flowNodeRef>ESP_tobt</flowNodeRef></lane><lane id="L_oper" name="Operador de Solo/Rampa"><flowNodeRef>IE_aibt</flowNodeRef><flowNodeRef>T_calcar</flowNodeRef><flowNodeRef>F1</flowNodeRef><flowNodeRef>T_desemb</flowNodeRef><flowNodeRef>ITS_desemb</flowNodeRef><flowNodeRef>F2</flowNodeRef><flowNodeRef>T_limp</flowNodeRef><flowNodeRef>T_cat</flowNodeRef><flowNodeRef>J2</flowNodeRef><flowNodeRef>G_pax</flowNodeRef><flowNodeRef>ICS_fuel</flowNodeRef><flowNodeRef>M_pax</flowNodeRef><flowNodeRef>T_emb</flowNodeRef><flowNodeRef>T_desc</flowNodeRef><flowNodeRef>T_carr</flowNodeRef><flowNodeRef>G_fuel</flowNodeRef><flowNodeRef>ICS_desemb</flowNodeRef><flowNodeRef>M_fuel</flowNodeRef><flowNodeRef>T_fuel</flowNodeRef><flowNodeRef>ITS_fuel</flowNodeRef><flowNodeRef>T_agua</flowNodeRef><flowNodeRef>T_insp</flowNodeRef><flowNodeRef>J3</flowNodeRef><flowNodeRef>T_load</flowNodeRef><flowNodeRef>J4</flowNodeRef><flowNodeRef>T_portas</flowNodeRef><flowNodeRef>IE_atc</flowNodeRef><flowNodeRef>T_push</flowNodeRef></lane><lane id="L_motor" name="Motor de Eventos"><flowNodeRef>T_viab</flowNodeRef><flowNodeRef>G_viab</flowNodeRef><flowNodeRef>T_verif</flowNodeRef><flowNodeRef>G_pend</flowNodeRef><flowNodeRef>T_fim</flowNodeRef><flowNodeRef>E_fim</flowNodeRef><flowNodeRef>ESP_mon</flowNodeRef></lane><lane id="L_aut" name="Autoridade de Liberação"><flowNodeRef>T_lib</flowNodeRef></lane></laneSet><startEvent id="S0" name="Voo previsto para a posição"><outgoing>F_S0_T_abrir</outgoing><messageEventDefinition id="ED_S0" messageRef="Msg_voo"/></startEvent><userTask id="T_abrir" name="Abrir o turnaround: tarefas, janelas, dependências e responsáveis"><incoming>F_S0_T_abrir</incoming><outgoing>F_T_abrir_T_viab</outgoing></userTask><serviceTask id="T_viab" name="Verificar a viabilidade (EIBT + MTTT ≤ TOBT)"><incoming>F_T_abrir_T_viab</incoming><incoming>F_T_ajustar_T_viab</incoming><outgoing>F_T_viab_G_viab</outgoing></serviceTask><exclusiveGateway id="G_viab" name="Turnaround viável?"><incoming>F_T_viab_G_viab</incoming><outgoing>F_G_viab_T_ajustar</outgoing><outgoing>F_G_viab_IE_aibt</outgoing></exclusiveGateway><userTask id="T_ajustar" name="Ajustar o plano ou o TOBT"><incoming>F_G_viab_T_ajustar</incoming><outgoing>F_T_ajustar_T_viab</outgoing></userTask><intermediateCatchEvent id="IE_aibt" name="Aeronave em posição (AIBT)"><incoming>F_G_viab_IE_aibt</incoming><outgoing>F_IE_aibt_T_calcar</outgoing><messageEventDefinition id="ED_IE_aibt" messageRef="Msg_aibt"/></intermediateCatchEvent><userTask id="T_calcar" name="Posicionar ponte ou escada e registrar o início do atendimento (ACGT)"><incoming>F_IE_aibt_T_calcar</incoming><outgoing>F_T_calcar_F1</outgoing></userTask><parallelGateway id="F1" name=""><incoming>F_T_calcar_F1</incoming><outgoing>F_F1_T_desemb</outgoing><outgoing>F_F1_T_desc</outgoing><outgoing>F_F1_G_fuel</outgoing><outgoing>F_F1_T_agua</outgoing><outgoing>F_F1_T_insp</outgoing></parallelGateway><userTask id="T_desemb" name="Desembarcar os passageiros"><incoming>F_F1_T_desemb</incoming><outgoing>F_T_desemb_ITS_desemb</outgoing></userTask><intermediateThrowEvent id="ITS_desemb" name="Desembarque concluído"><incoming>F_T_desemb_ITS_desemb</incoming><outgoing>F_ITS_desemb_F2</outgoing><signalEventDefinition id="ED_ITS_desemb" signalRef="Sig_desemb"/></intermediateThrowEvent><parallelGateway id="F2" name=""><incoming>F_ITS_desemb_F2</incoming><outgoing>F_F2_T_limp</outgoing><outgoing>F_F2_T_cat</outgoing></parallelGateway><userTask id="T_limp" name="Limpar a cabine (confirmação por QR Code)"><incoming>F_F2_T_limp</incoming><outgoing>F_T_limp_J2</outgoing></userTask><userTask id="T_cat" name="Carregar o catering"><incoming>F_F2_T_cat</incoming><outgoing>F_T_cat_J2</outgoing></userTask><parallelGateway id="J2" name=""><incoming>F_T_limp_J2</incoming><incoming>F_T_cat_J2</incoming><outgoing>F_J2_G_pax</outgoing></parallelGateway><exclusiveGateway id="G_pax" name="Abastecimento com passageiros permitido?"><incoming>F_J2_G_pax</incoming><outgoing>F_G_pax_M_pax</outgoing><outgoing>F_G_pax_ICS_fuel</outgoing></exclusiveGateway><intermediateCatchEvent id="ICS_fuel" name="Abastecimento concluído"><incoming>F_G_pax_ICS_fuel</incoming><outgoing>F_ICS_fuel_M_pax</outgoing><conditionalEventDefinition id="ED_ICS_fuel"><condition xsi:type="tFormalExpression">abastecimentoDoTurnaroundConcluido = true</condition></conditionalEventDefinition></intermediateCatchEvent><exclusiveGateway id="M_pax" name=""><incoming>F_G_pax_M_pax</incoming><incoming>F_ICS_fuel_M_pax</incoming><outgoing>F_M_pax_T_emb</outgoing></exclusiveGateway><userTask id="T_emb" name="Embarcar os passageiros (ASBT)"><incoming>F_M_pax_T_emb</incoming><outgoing>F_T_emb_J3</outgoing></userTask><userTask id="T_desc" name="Descarregar bagagem e carga"><incoming>F_F1_T_desc</incoming><outgoing>F_T_desc_T_carr</outgoing></userTask><userTask id="T_carr" name="Carregar bagagem e carga"><incoming>F_T_desc_T_carr</incoming><outgoing>F_T_carr_J3</outgoing></userTask><exclusiveGateway id="G_fuel" name="Abastecimento com passageiros permitido?"><incoming>F_F1_G_fuel</incoming><outgoing>F_G_fuel_M_fuel</outgoing><outgoing>F_G_fuel_ICS_desemb</outgoing></exclusiveGateway><intermediateCatchEvent id="ICS_desemb" name="Desembarque concluído"><incoming>F_G_fuel_ICS_desemb</incoming><outgoing>F_ICS_desemb_M_fuel</outgoing><conditionalEventDefinition id="ED_ICS_desemb"><condition xsi:type="tFormalExpression">desembarqueDoTurnaroundConcluido = true</condition></conditionalEventDefinition></intermediateCatchEvent><exclusiveGateway id="M_fuel" name=""><incoming>F_G_fuel_M_fuel</incoming><incoming>F_ICS_desemb_M_fuel</incoming><outgoing>F_M_fuel_T_fuel</outgoing></exclusiveGateway><userTask id="T_fuel" name="Abastecer a aeronave"><incoming>F_M_fuel_T_fuel</incoming><outgoing>F_T_fuel_ITS_fuel</outgoing></userTask><intermediateThrowEvent id="ITS_fuel" name="Abastecimento concluído"><incoming>F_T_fuel_ITS_fuel</incoming><outgoing>F_ITS_fuel_J4</outgoing><signalEventDefinition id="ED_ITS_fuel" signalRef="Sig_fuel"/></intermediateThrowEvent><userTask id="T_agua" name="Atender água potável e lavatórios"><incoming>F_F1_T_agua</incoming><outgoing>F_T_agua_J4</outgoing></userTask><userTask id="T_insp" name="Realizar a inspeção técnica de trânsito"><incoming>F_F1_T_insp</incoming><outgoing>F_T_insp_J4</outgoing></userTask><parallelGateway id="J3" name=""><incoming>F_T_emb_J3</incoming><incoming>F_T_carr_J3</incoming><outgoing>F_J3_T_load</outgoing></parallelGateway><userTask id="T_load" name="Emitir a loadsheet (peso e balanceamento)"><incoming>F_J3_T_load</incoming><outgoing>F_T_load_J4</outgoing></userTask><parallelGateway id="J4" name=""><incoming>F_T_load_J4</incoming><incoming>F_ITS_fuel_J4</incoming><incoming>F_T_agua_J4</incoming><incoming>F_T_insp_J4</incoming><outgoing>F_J4_T_portas</outgoing></parallelGateway><userTask id="T_portas" name="Fechar portas, retirar a ponte e registrar o fim do atendimento (AEGT)"><incoming>F_J4_T_portas</incoming><outgoing>F_T_portas_T_verif</outgoing></userTask><serviceTask id="T_verif" name="Verificar tarefas obrigatórias e exceções abertas (Pronto para liberação)"><incoming>F_T_portas_T_verif</incoming><incoming>F_T_tratar_T_verif</incoming><outgoing>F_T_verif_G_pend</outgoing></serviceTask><exclusiveGateway id="G_pend" name="Há tarefa obrigatória pendente ou exceção aberta?"><incoming>F_T_verif_G_pend</incoming><outgoing>F_G_pend_T_tratar</outgoing><outgoing>F_G_pend_T_lib</outgoing></exclusiveGateway><userTask id="T_tratar" name="Tratar a pendência ou a exceção"><incoming>F_G_pend_T_tratar</incoming><outgoing>F_T_tratar_T_verif</outgoing></userTask><userTask id="T_lib" name="Confirmar a prontidão e liberar a aeronave (ARDT)"><incoming>F_G_pend_T_lib</incoming><outgoing>F_T_lib_IE_atc</outgoing></userTask><intermediateCatchEvent id="IE_atc" name="Autorização de acionamento e push-back recebida"><incoming>F_T_lib_IE_atc</incoming><outgoing>F_IE_atc_T_push</outgoing><messageEventDefinition id="ED_IE_atc" messageRef="Msg_atc"/></intermediateCatchEvent><userTask id="T_push" name="Fazer o push-back e registrar a saída da posição (AOBT)"><incoming>F_IE_atc_T_push</incoming><outgoing>F_T_push_T_fim</outgoing></userTask><serviceTask id="T_fim" name="Encerrar o turnaround (Fora de bloco)"><incoming>F_T_push_T_fim</incoming><outgoing>F_T_fim_E_fim</outgoing></serviceTask><endEvent id="E_fim" name="Turnaround encerrado"><incoming>F_T_fim_E_fim</incoming></endEvent><subProcess id="ESP_mon" name="Monitoramento a cada registro (Motor de Eventos)" triggeredByEvent="true"><startEvent id="S_mon" name="Registro de andamento recebido (início, pausa, conclusão, não aplicável, QR Code)" isInterrupting="false"><outgoing>F_S_mon_T_rec</outgoing><messageEventDefinition id="ED_S_mon" messageRef="Msg_reg"/></startEvent><serviceTask id="T_rec" name="Propagar estados e recalcular projeção, caminho crítico e aderência ao TOBT + 5 min"><incoming>F_S_mon_T_rec</incoming><outgoing>F_T_rec_T_painel</outgoing></serviceTask><serviceTask id="T_painel" name="Atualizar o painel (até 5 s)"><incoming>F_T_rec_T_painel</incoming><outgoing>F_T_painel_G_desvio</outgoing></serviceTask><exclusiveGateway id="G_desvio" name="Há desvio?"><incoming>F_T_painel_G_desvio</incoming><outgoing>F_G_desvio_E_risco</outgoing><outgoing>F_G_desvio_E_prev</outgoing><outgoing>F_G_desvio_E_ok</outgoing></exclusiveGateway><endEvent id="E_risco" name="Alerta de risco ao horário"><incoming>F_G_desvio_E_risco</incoming><signalEventDefinition id="ED_E_risco" signalRef="Sig_risco"/></endEvent><endEvent id="E_prev" name="Pedido de atualização da previsão"><incoming>F_G_desvio_E_prev</incoming><signalEventDefinition id="ED_E_prev" signalRef="Sig_prev"/></endEvent><endEvent id="E_ok" name="Sem desvio"><incoming>F_G_desvio_E_ok</incoming></endEvent><sequenceFlow id="F_S_mon_T_rec" name="" sourceRef="S_mon" targetRef="T_rec"/><sequenceFlow id="F_T_rec_T_painel" name="" sourceRef="T_rec" targetRef="T_painel"/><sequenceFlow id="F_T_painel_G_desvio" name="" sourceRef="T_painel" targetRef="G_desvio"/><sequenceFlow id="F_G_desvio_E_risco" name="Risco ao horário (T8, T11, T12)" sourceRef="G_desvio" targetRef="E_risco"/><sequenceFlow id="F_G_desvio_E_prev" name="Antecipação ≥ 5 min" sourceRef="G_desvio" targetRef="E_prev"/><sequenceFlow id="F_G_desvio_E_ok" name="Não" sourceRef="G_desvio" targetRef="E_ok"/></subProcess><subProcess id="ESP_alerta" name="Tratamento de alerta de risco" triggeredByEvent="true"><startEvent id="S_al" name="Alerta de risco ao horário" isInterrupting="false"><outgoing>F_S_al_T_al</outgoing><signalEventDefinition id="ED_S_al" signalRef="Sig_risco"/></startEvent><userTask id="T_al" name="Tratar o alerta: redistribuir recursos, replanejar e registrar a causa (código ANAC)"><incoming>F_S_al_T_al</incoming><outgoing>F_T_al_E_al</outgoing></userTask><endEvent id="E_al" name="Ação registrada"><incoming>F_T_al_E_al</incoming></endEvent><sequenceFlow id="F_S_al_T_al" name="" sourceRef="S_al" targetRef="T_al"/><sequenceFlow id="F_T_al_E_al" name="" sourceRef="T_al" targetRef="E_al"/></subProcess><subProcess id="ESP_prev" name="Atualização da previsão (ADR-0003)" triggeredByEvent="true"><startEvent id="S_pv" name="Pedido de atualização da previsão" isInterrupting="false"><outgoing>F_S_pv_T_pv</outgoing><signalEventDefinition id="ED_S_pv" signalRef="Sig_prev"/></startEvent><userTask id="T_pv" name="Atualizar a previsão (TOBT)"><incoming>F_S_pv_T_pv</incoming><outgoing>F_T_pv_E_pv</outgoing></userTask><endEvent id="E_pv" name="Previsão atualizada"><incoming>F_T_pv_E_pv</incoming></endEvent><sequenceFlow id="F_S_pv_T_pv" name="" sourceRef="S_pv" targetRef="T_pv"/><sequenceFlow id="F_T_pv_E_pv" name="" sourceRef="T_pv" targetRef="E_pv"/></subProcess><subProcess id="ESP_tobt" name="Checagem em TOBT − 15 min" triggeredByEvent="true"><startEvent id="S_tb" name="TOBT − 15 min" isInterrupting="false"><outgoing>F_S_tb_T_tb</outgoing><timerEventDefinition id="TD_S_tb"><timeDate xsi:type="tFormalExpression">TOBT - 15 min</timeDate></timerEventDefinition></startEvent><userTask id="T_tb" name="Conferir o prazo com todas as equipes e ajustar o TOBT se preciso"><incoming>F_S_tb_T_tb</incoming><outgoing>F_T_tb_E_tb</outgoing></userTask><endEvent id="E_tb" name="Prazo conferido"><incoming>F_T_tb_E_tb</incoming></endEvent><sequenceFlow id="F_S_tb_T_tb" name="" sourceRef="S_tb" targetRef="T_tb"/><sequenceFlow id="F_T_tb_E_tb" name="" sourceRef="T_tb" targetRef="E_tb"/></subProcess><sequenceFlow id="F_S0_T_abrir" name="" sourceRef="S0" targetRef="T_abrir"/><sequenceFlow id="F_T_abrir_T_viab" name="" sourceRef="T_abrir" targetRef="T_viab"/><sequenceFlow id="F_T_viab_G_viab" name="" sourceRef="T_viab" targetRef="G_viab"/><sequenceFlow id="F_G_viab_T_ajustar" name="Não" sourceRef="G_viab" targetRef="T_ajustar"/><sequenceFlow id="F_T_ajustar_T_viab" name="" sourceRef="T_ajustar" targetRef="T_viab"/><sequenceFlow id="F_G_viab_IE_aibt" name="Sim" sourceRef="G_viab" targetRef="IE_aibt"/><sequenceFlow id="F_IE_aibt_T_calcar" name="" sourceRef="IE_aibt" targetRef="T_calcar"/><sequenceFlow id="F_T_calcar_F1" name="" sourceRef="T_calcar" targetRef="F1"/><sequenceFlow id="F_F1_T_desemb" name="" sourceRef="F1" targetRef="T_desemb"/><sequenceFlow id="F_F1_T_desc" name="" sourceRef="F1" targetRef="T_desc"/><sequenceFlow id="F_F1_G_fuel" name="" sourceRef="F1" targetRef="G_fuel"/><sequenceFlow id="F_F1_T_agua" name="" sourceRef="F1" targetRef="T_agua"/><sequenceFlow id="F_F1_T_insp" name="" sourceRef="F1" targetRef="T_insp"/><sequenceFlow id="F_T_desemb_ITS_desemb" name="" sourceRef="T_desemb" targetRef="ITS_desemb"/><sequenceFlow id="F_ITS_desem