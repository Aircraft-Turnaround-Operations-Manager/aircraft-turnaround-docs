COO -- UC26
COO -- UC27
COO -- UC28
COO -- UC29
COO -- UC30
COO -- UC31
COO -- UC33
COO -- UC34
COO -- UC35
COO -- UC36

OPE -- UC12
OPE -- UC14
OPE -- UC15
OPE -- UC16
OPE -- UC17
OPE -- UC18
OPE -- UC19
OPE -- UC37

AUT -- UC32

UC20 -- MOT
UC21 -- MOT
UC24 -- MOT
UC25 -- MOT
UC27 -- MOT
UC34 -- MOT

