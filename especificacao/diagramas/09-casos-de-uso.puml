@startuml 09-casos-de-uso
' Item 9 — Diagrama geral de casos de uso
' Fonte única dos nomes, atores e relacionamentos: tabelas no topo de
' especificacao/10-especificacoes-de-caso-de-uso/area-a.md a area-d.md (critério C10.8).
' IDs finais conforme entregas/ra1-renumeracao.md (ADR-0011).

left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle {
  BorderColor #333333
}
skinparam ArrowColor #333333

actor "//Usuário//\n(ator abstrato)" as USU
actor "Administrador do Sistema" as ADM
actor "Coordenador de Turnaround" as COO
actor "Operador de Solo/Rampa" as OPE
actor "Autoridade de Liberação" as AUT
actor "Motor de Eventos\n<<sistema>>" as MOT

ADM -up-|> USU
COO -up-|> USU
OPE -up-|> USU
AUT -up-|> USU

rectangle "Aircraft Turnaround Orchestration System" {

  rectangle "Acesso e planejamento" {
    usecase "UC01 — Autenticar-se" as UC01
    usecase "UC02 — Gerenciar usuários e\nperfis de acesso" as UC02
    usecase "UC09 — Gerenciar equipes\ne especialidades" as UC09
    usecase "UC03 — Abrir turnaround" as UC03
    usecase "UC04 — Criar modelo de tarefas" as UC04
    usecase "UC07 — Configurar pontos\nde confirmação" as UC07
    usecase "UC08 — Definir dependências\nentre tarefas" as UC08
    usecase "UC06 — Aplicar modelo de tarefas" as UC06
    usecase "UC05 — Confirmar plano inicial" as UC05
    usecase "UC11 — Configurar política\nde abastecimento" as UC11
    usecase "UC10 — Atualizar referências\nde previsão" as UC10
    usecase "UC12 — Registrar chegada\nà posição" as UC12
    usecase "UC13 — Corrigir chegada\nà posição" as UC13
  }

  rectangle "Execução em solo" {
    usecase "UC14 — Consultar as tarefas da equipe\natribuídas ao operador" as UC14
    usecase "UC15 — Iniciar tarefa" as UC15
    usecase "UC16 — Concluir tarefa" as UC16
    usecase "UC17 — Pausar e retomar tarefa" as UC17
    usecase "UC18 — Marcar tarefa como\n“Não aplicável”" as UC18
    usecase "UC19 — Confirmar a execução da\ntarefa por QR Code" as UC19
    usecase "UC20 — Registrar os marcos do\natendimento em solo" as UC20
    usecase "UC21 — Propagar o estado das\ntarefas e do turnaround" as UC21
  }

  rectangle "Monitoramento" {
    usecase "UC22 — Acompanhar os\nturnarounds no painel" as UC22
    usecase "UC23 — Consultar a linha do\ntempo do turnaround" as UC23
    usecase "UC24 — Recalcular a projeção, o\natraso e o caminho crítico" as UC24
    usecase "UC25 — Emitir alertas de\nrisco ao horário" as UC25
    usecase "UC26 — Consultar a lista de\nalertas abertos" as UC26
    usecase "UC27 — Registrar a checagem com\nas equipes em TOBT − 15" as UC27
    usecase "UC28 — Consultar os indicadores\nde aderência" as UC28
  }

  rectangle "Exceções e liberação" {
    usecase "UC31 — Registrar a ação tomada\npara o alerta" as UC31
    usecase "UC29 — Abrir exceção" as UC29
    usecase "UC30 — Reatribuir tarefa" as UC30
    usecase "UC36 — Consultar os operadores\ndisponíveis da equipe" as UC36
    usecase "UC34 — Atualizar o TOBT" as UC34
    usecase "UC35 — Replanejar tarefas\nainda não iniciadas" as UC35
    usecase "UC33 — Encerrar exceção" as UC33
    usecase "UC32 — Confirmar a prontidão e\nliberar a aeronave" as UC32
    usecase "UC37 — Registrar a saída da posição\ne encerrar o turnaround" as UC37
  }
}

' ---------- Associações ator × caso de uso ----------
USU -- UC01

ADM -- UC02
ADM -- UC09

COO -- UC03
